// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DRIVER
  BROKER
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleType {
  CAR
  VAN
  PICKUP
  TRUCK
  TRAILER
  REFRIGERATED_TRUCK
  FLATBED
  TANKER
  OTHER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  SUSPENDED
}

enum TripStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TripStopType {
  PICKUP
  DELIVERY
  WAYPOINT
}

enum DeliveryRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
  CLOSED
}

enum ShipmentStatus {
  CREATED
  CONFIRMED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
}

enum TrackingEventType {
  CREATED
  PICKED_UP
  IN_TRANSIT
  ARRIVED_AT_PICKUP
  ARRIVED_AT_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  DELAYED
  CANCELLED
  LOCATION_UPDATE
  OTHER
}

enum ProofOfDeliveryType {
  SIGNATURE
  PHOTO
  DOCUMENT
  OTP
  OTHER
}

enum DocumentType {
  DRIVER_LICENSE
  VEHICLE_REGISTRATION
  INSURANCE
  CNIC
  BUSINESS_LICENSE
  PROOF_OF_DELIVERY
  OTHER
}

enum NotificationType {
  ACCOUNT
  APPROVAL
  TRIP
  DELIVERY_REQUEST
  SHIPMENT
  PAYMENT
  DISPUTE
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}

enum DisputeReason {
  DAMAGED_GOODS
  LOST_GOODS
  LATE_DELIVERY
  PAYMENT_ISSUE
  DRIVER_ISSUE
  BROKER_ISSUE
  OTHER
}

enum ApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
  REACTIVATED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SUSPEND
  LOGIN
  LOGOUT
  ACCEPT
  CANCEL
  COMPLETE
  OTHER
}

// ============================================================
// USER
// ============================================================

model User {
  id Int @id @default(autoincrement())

  name     String
  email    String @unique
  password String

  phone  String?
  role   UserRole   @default(BROKER)
  status UserStatus @default(PENDING)

  isEmailVerified Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // ----------------------------------------------------------
  // Approval
  // ----------------------------------------------------------

  approvedAt    DateTime?
  approvedById  Int?
  approvedBy    User?     @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers User[]    @relation("UserApprovals")

  // ----------------------------------------------------------
  // Driver
  // ----------------------------------------------------------

  vehicles Vehicle[]

  trips Trip[] @relation("DriverTrips")

  // ----------------------------------------------------------
  // Broker
  // ----------------------------------------------------------

  deliveryRequests DeliveryRequest[] @relation("BrokerRequests")

  // ----------------------------------------------------------
  // Notifications
  // ----------------------------------------------------------

  notifications Notification[]

  // ----------------------------------------------------------
  // Documents
  // ----------------------------------------------------------

  documents Document[]

  // ----------------------------------------------------------
  // Authentication
  // ----------------------------------------------------------

  refreshTokens RefreshToken[]

  emailVerificationTokens EmailVerificationToken[]

  passwordResetTokens PasswordResetToken[]

  // ----------------------------------------------------------
  // Ratings
  // ----------------------------------------------------------

  reviewsGiven    Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")

  // ----------------------------------------------------------
  // Disputes
  // ----------------------------------------------------------

  disputesRaised Dispute[] @relation("DisputeRaisedBy")

  // ----------------------------------------------------------
  // Audit
  // ----------------------------------------------------------

  auditLogs AuditLog[]

  // ----------------------------------------------------------
  // Approval History
  // ----------------------------------------------------------

  approvalHistory          ApprovalHistory[] @relation("UserApprovalHistory")
  approvalActionsPerformed ApprovalHistory[] @relation("ApprovalPerformedBy")

  @@index([role])
  @@index([status])
  @@index([email])
  @@index([phone])
}

// ============================================================
// VEHICLE
// ============================================================

model Vehicle {
  id Int @id @default(autoincrement())

  driverId Int
  driver   User @relation(fields: [driverId], references: [id])

  type   VehicleType
  status VehicleStatus @default(ACTIVE)

  make  String?
  model String?
  year  Int?

  registrationNumber String  @unique
  licensePlate       String?

  capacityKg Decimal @db.Decimal(12, 2)

  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  trips Trip[]

  documents Document[]

  @@index([driverId])
  @@index([status])
  @@index([type])
}

// ============================================================
// TRIP
// ============================================================

model Trip {
  id Int @id @default(autoincrement())

  driverId Int
  driver   User @relation("DriverTrips", fields: [driverId], references: [id])

  vehicleId Int?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  status TripStatus @default(DRAFT)

  origin      String
  destination String

  originLatitude  Decimal? @db.Decimal(10, 7)
  originLongitude Decimal? @db.Decimal(10, 7)

  destinationLatitude  Decimal? @db.Decimal(10, 7)
  destinationLongitude Decimal? @db.Decimal(10, 7)

  departureDate        DateTime?
  estimatedArrivalDate DateTime?

  totalCapacityKg     Decimal @db.Decimal(12, 2)
  availableCapacityKg Decimal @db.Decimal(12, 2)

  description String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  cancelledAt DateTime?

  stops TripStop[]

  deliveryRequests DeliveryRequest[]

  shipments Shipment[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([origin])
  @@index([destination])
  @@index([departureDate])
}

// ============================================================
// TRIP STOPS
// ============================================================

model TripStop {
  id Int @id @default(autoincrement())

  tripId Int
  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  type TripStopType

  sequence Int

  location String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  estimatedArrival DateTime?
  actualArrival    DateTime?

  notes String?

  createdAt DateTime @default(now())

  @@unique([tripId, sequence])
  @@index([tripId])
}

// ============================================================
// DELIVERY REQUEST
// ============================================================

model DeliveryRequest {
  id Int @id @default(autoincrement())

  tripId Int
  trip   Trip @relation(fields: [tripId], references: [id])

  brokerId Int
  broker   User @relation("BrokerRequests", fields: [brokerId], references: [id])

  status DeliveryRequestStatus @default(PENDING)

  pickupLocation   String
  deliveryLocation String

  pickupLatitude  Decimal? @db.Decimal(10, 7)
  pickupLongitude Decimal? @db.Decimal(10, 7)

  deliveryLatitude  Decimal? @db.Decimal(10, 7)
  deliveryLongitude Decimal? @db.Decimal(10, 7)

  cargoDescription String

  weightKg Decimal @db.Decimal(12, 2)

  requestedAt DateTime  @default(now())
  respondedAt DateTime?

  rejectionReason    String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipment Shipment?

  @@unique([tripId, brokerId])
  @@index([tripId])
  @@index([brokerId])
  @@index([status])
}

// ============================================================
// SHIPMENT
// ============================================================

model Shipment {
  id Int @id @default(autoincrement())

  requestId Int             @unique
  request   DeliveryRequest @relation(fields: [requestId], references: [id])

  tripId Int
  trip   Trip @relation(fields: [tripId], references: [id])

  status ShipmentStatus @default(CREATED)

  trackingNumber String @unique

  cargoDescription String
  weightKg         Decimal @db.Decimal(12, 2)

  pickupLocation   String
  deliveryLocation String

  pickupDate   DateTime?
  deliveryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackingEvents ShipmentTrackingEvent[]

  proofOfDelivery ProofOfDelivery?

  reviews Review[]

  disputes Dispute[]

  documents Document[]

  @@index([tripId])
  @@index([status])
  @@index([trackingNumber])
}

// ============================================================
// SHIPMENT TRACKING
// ============================================================

model ShipmentTrackingEvent {
  id Int @id @default(autoincrement())

  shipmentId Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  type TrackingEventType

  status ShipmentStatus?

  location String?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  description String?

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================
// PROOF OF DELIVERY
// ============================================================

model ProofOfDelivery {
  id Int @id @default(autoincrement())

  shipmentId Int      @unique
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  type ProofOfDeliveryType

  recipientName String?

  signatureUrl String?
  photoUrl     String?
  documentUrl  String?

  otpVerified Boolean @default(false)

  notes String?

  deliveredAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// REVIEWS / RATINGS
// ============================================================

model Review {
  id Int @id @default(autoincrement())

  shipmentId Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  reviewerId Int
  reviewer   User @relation("ReviewsGiven", fields: [reviewerId], references: [id])

  revieweeId Int
  reviewee   User @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  rating Int

  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shipmentId, reviewerId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@index([rating])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  title   String
  message String

  status NotificationStatus @default(UNREAD)

  data Json?

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// DISPUTES
// ============================================================

model Dispute {
  id Int @id @default(autoincrement())

  shipmentId Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  raisedById Int
  raisedBy   User @relation("DisputeRaisedBy", fields: [raisedById], references: [id])

  reason DisputeReason

  status DisputeStatus @default(OPEN)

  title       String
  description String

  resolution String?

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
  @@index([raisedById])
  @@index([status])
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id Int @id @default(autoincrement())

  type DocumentType

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleId Int?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  shipmentId Int?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl  String

  mimeType String?
  fileSize Int?

  verified Boolean @default(false)

  verifiedAt DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([vehicleId])
  @@index([shipmentId])
  @@index([type])
}

// ============================================================
// APPROVAL HISTORY
// ============================================================

model ApprovalHistory {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation("UserApprovalHistory", fields: [userId], references: [id], onDelete: Cascade)

  action ApprovalAction

  performedById Int?
  performedBy   User? @relation("ApprovalPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  reason String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([performedById])
  @@index([action])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id Int @id @default(autoincrement())

  actorId Int?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action AuditAction

  entityType String
  entityId   String

  oldData Json?
  newData Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// REFRESH TOKENS
// ============================================================

model RefreshToken {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// EMAIL VERIFICATION
// ============================================================

model EmailVerificationToken {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// PASSWORD RESET
// ============================================================

model PasswordResetToken {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
